{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "module": "nodenext",
    "rootDir": "./src",
    "outDir": "./dist",

    "types": ["node"],
    "declaration": true,

    "lib": ["es2022"]
  },
  "include": ["src/**/*.ts"]
}
